{
  "manifest_version": 3,
  "name": "九漾 Onda 发布扩展",
  "version": "0.2.0",
  "description": "连接本机九漾 Onda 发布服务，在用户日常浏览器中执行发布任务。",
  "key": "",
  "permissions": ["storage", "scripting", "tabs", "alarms", "nativeMessaging"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://doubao.com/*",
    "https://www.doubao.com/*",
    "https://weibo.com/*",
    "https://passport.weibo.com/*",
    "https://mp.weixin.qq.com/*",
    "https://creator.xiaohongshu.com/*",
    "https://web.okjike.com/*",
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://x.com/*",
    "https://www.douban.com/*",
    "https://m.douban.com/*",
    "https://www.xiaoyuzhoufm.com/*",
    "https://podcaster.xiaoyuzhoufm.com/*",
    "https://www.ximalaya.com/*",
    "https://studio.ximalaya.com/*",
    "https://passport.ximalaya.com/*",
    "https://nj.lizhi.fm/*",
    "https://admin.qingting.fm/*",
    "https://papi.qingting.fm/*",
    "https://upload.qtfm.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "九漾 Onda",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
