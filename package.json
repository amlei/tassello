{
  "name": "tassello",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/platforms/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "build:web": "cd apps/web && bun run build",
    "start:web": "cd apps/web && bun run start",
    "desktop": "cd apps/desktop && bun run desktop",
    "db:migrate": "cd packages/db && bunx prisma migrate dev",
    "typecheck": "bun run scripts/typecheck.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
