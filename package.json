{
  "name": "tassello",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/platforms/*"
  ],
  "scripts": {
    "build:obsidian": "cd apps/obsidian && bun run build",
    "build:cli": "cd apps/cli && bun run build",
    "build:extension": "cd apps/extension && bun run build",
    "build:native-host": "cd apps/native-host && bun run build",
    "build:web": "cd apps/web && bun run build",
    "package:extension": "cd apps/extension && bun run package",
    "db:generate": "cd packages/db && bunx prisma generate",
    "desktop": "TASSELLO_DESKTOP=1 bun scripts/dev.ts",
    "desktop:bundle": "cd apps/desktop && bun run desktop",
    "dev": "bun scripts/dev.ts",
    "dev:api": "cd apps/api && bun run dev",
    "cli": "bun apps/cli/src/index.ts",
    "dev:desktop": "TASSELLO_DESKTOP=1 bun scripts/dev.ts",
    "migrate:vault": "bun scripts/migrate-vault.ts",
    "dev:web": "cd apps/web && bun run dev",
    "package:obsidian": "cd apps/obsidian && bun run package",
    "start:web": "cd apps/web && bun run start",
    "test:obsidian": "cd apps/obsidian && bun test",
    "typecheck": "bun run scripts/typecheck.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
